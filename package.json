{
  "name": "pi-hapi-remote",
  "version": "0.1.0",
  "description": "临时分享并远端控制当前 Pi Session 的扩展包：本机 HTTP Bridge + Tunnelmole 隧道 + 静态 PWA。",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/pi-hapi-remote/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm --filter pi-hapi-remote-web typecheck",
    "build:web": "pnpm --filter pi-hapi-remote-web build",
    "dev:web": "pnpm --filter pi-hapi-remote-web dev",
    "preview:web": "pnpm --filter pi-hapi-remote-web preview"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "@earendil-works/pi-agent-core": "*"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "tunnelmole": "^2.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "typebox": "^1.1.38",
    "typescript": "^5.7.0",
    "@earendil-works/pi-agent-core": "^0.84.2"
  },
  "engines": {
    "node": ">=20"
  }
}
