{
  "name": "pi-hapi-remote",
  "version": "0.2.1",
  "description": "临时分享并远端控制当前 Pi Session 的扩展包：本机 HTTP Bridge + Tunnelmole 隧道 + 静态 PWA。",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orangelckc/pi-hapi-remote.git"
  },
  "homepage": "https://github.com/orangelckc/pi-hapi-remote#readme",
  "bugs": {
    "url": "https://github.com/orangelckc/pi-hapi-remote/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.mjs"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm --filter pi-hapi-remote-web typecheck",
    "build:web": "pnpm --filter pi-hapi-remote-web build",
    "build:package": "pnpm typecheck && pnpm build:web && node scripts/build-package.mjs",
    "prepack": "pnpm build:package",
    "dev:web": "pnpm --filter pi-hapi-remote-web dev",
    "preview:web": "pnpm --filter pi-hapi-remote-web preview"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "esbuild": "^0.25.12",
    "qrcode": "^1.5.4",
    "tunnelmole": "^2.2.0",
    "typebox": "^1.1.38",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
